# PDSChain Environment Configuration Template
PORT=3000
NODE_ENV=development

# Database Configuration
# Provide PostgreSQL URL for production, or leave blank to use automatic SQLite fallback
# Example: DATABASE_URL=postgres://postgres:password@localhost:5432/pdschain
DATABASE_URL=
DATABASE_STORAGE=../database/pdschain.sqlite

# Security & Authentication
JWT_SECRET=pdschain_dev_super_secret_jwt_key_2026
JWT_EXPIRES_IN=24h

# Blockchain Parameters
BLOCKCHAIN_DIFFICULTY=2
VALIDATOR_COUNT=12

# CORS Configuration
CORS_ORIGIN=*

