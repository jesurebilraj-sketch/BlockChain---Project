{
  "name": "pdschain-backend",
  "version": "1.0.0",
  "description": "Production-quality backend for PDSChain: Blockchain-Based Public Distribution System with Federated Byzantine Agreement (FBA) consensus.",
  "main": "src/server.js",
  "scripts": {
